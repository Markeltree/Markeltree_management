# Copy to server/.env for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# Supabase Postgres (Dashboard → Connect → ORMs → Prisma)
# Local dev: session pooler (port 5432). Vercel: transaction pooler (port 6543) with
#   ?pgbouncer=true&connection_limit=5
DATABASE_URL=
# Session-mode / direct connection (port 5432), used by Prisma migrations
DIRECT_URL=

NODE_ENV=development
PORT=4000
# Comma-separated allowed origins, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# At least 32 random characters
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Initial Super Admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Supabase Realtime (Dashboard → Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
