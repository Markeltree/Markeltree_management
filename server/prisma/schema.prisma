// Markeltree — In-House Employee Management & Collaboration Platform
// Data model follows FRD/SRS §11. Database: PostgreSQL (Supabase).

generator client {
  provider        = "prisma-client-js"
  // Load nested relations with SQL JOINs in a single query instead of one query per relation.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: pooled connection (port 6543, pgbouncer) for the running app
  url       = env("DATABASE_URL")
  // Supabase: direct connection (port 5432) for migrations
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  EXITED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_DEPARTURE
  LATE_AND_EARLY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum AccessLevel {
  VIEW
  EDIT
  MANAGE
}

enum SubjectType {
  USER
  ROLE
  DEPARTMENT
  TEAM
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum TaxMode {
  NONE
  FIXED // fixed monthly amount
  PERCENT // percentage of taxable pay
}

enum AudienceType {
  ALL
  DEPARTMENT
  TEAM
  USERS
}

// ─────────────────────── Auth, Users & RBAC ───────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  status       UserStatus @default(INVITED)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  mfaEnabled   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employee            Employee?
  sessions            Session[]
  passwordResets      PasswordReset[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  auditLogs           AuditLog[]
  taskComments        TaskComment[]
  conversationsMade   Conversation[]           @relation("ConversationCreator")
  conversationMembers ConversationMember[]
  messages            Message[]
  files               File[]
  folders             Folder[]
  announcements       Announcement[]
  acknowledgements    AnnouncementAck[]
  tasksCreated        Task[]                   @relation("TaskCreator")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "employees.view_all"
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────── Organization & People ───────────────────────

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  headId      String?
  head        Employee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  teams       Team[]
  employees   Employee[] @relation("EmployeeDepartment")
}

model Team {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Employee?  @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  members      Employee[] @relation("EmployeeTeam")

  @@unique([departmentId, name])
}

model Employee {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String           @unique
  firstName        String
  lastName         String
  phone            String?
  personalEmail    String?
  dateOfBirth      DateTime?        @db.Date
  gender           String?
  address          String?
  avatarUrl        String?
  joiningDate      DateTime         @db.Date
  exitDate         DateTime?        @db.Date
  designation      String
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  departmentId     String?
  department       Department?      @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  teamId           String?
  team             Team?            @relation("EmployeeTeam", fields: [teamId], references: [id], onDelete: SetNull)
  managerId        String?
  manager          Employee?        @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]       @relation("ReportingLine")
  // Restricted fields (EMP-05) — only exposed with employees.view_sensitive
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  headOfDepartments Department[]        @relation("DepartmentHead")
  leadOfTeams       Team[]              @relation("TeamLead")
  history           EmploymentHistory[]
  documents         EmployeeDocument[]
  attendance        Attendance[]
  leaveRequests     LeaveRequest[]      @relation("LeaveRequester")
  leaveApprovals    LeaveRequest[]      @relation("LeaveApprover")
  leaveBalances     LeaveBalance[]
  salaryStructures  SalaryStructure[]
  payslips          Payslip[]
  tasksAssigned     Task[]              @relation("TaskAssignee")
  projectsOwned     Project[]           @relation("ProjectOwner")
  projectMembership ProjectMember[]

  @@index([departmentId])
  @@index([managerId])
}

model EmploymentHistory {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changeType    String // JOINED, DEPARTMENT_CHANGE, DESIGNATION_CHANGE, MANAGER_CHANGE, STATUS_CHANGE, EXITED
  fromValue     String?
  toValue       String?
  effectiveDate DateTime @db.Date
  note          String?
  changedById   String?
  createdAt     DateTime @default(now())

  @@index([employeeId])
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileId       String   @unique
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  category     String // CONTRACT, ID, CERTIFICATE, OTHER
  uploadedById String?
  createdAt    DateTime @default(now())
}

// ─────────────────────────── Attendance ───────────────────────────

model Attendance {
  id               String           @id @default(uuid())
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime         @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  workedMinutes    Int?
  status           AttendanceStatus
  isAdjusted       Boolean          @default(false)
  adjustmentReason String?
  adjustedById     String?
  checkInIp        String?
  checkOutIp       String?
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// ───────────────────────────── Leave ─────────────────────────────

model LeaveType {
  id               String         @id @default(uuid())
  name             String         @unique
  code             String         @unique
  annualAllowance  Decimal        @db.Decimal(5, 1)
  isPaid           Boolean        @default(true)
  requiresDocument Boolean        @default(false)
  carryForwardMax  Decimal        @default(0) @db.Decimal(5, 1)
  color            String?
  isActive         Boolean        @default(true)
  policy           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  requests         LeaveRequest[]
  balances         LeaveBalance[]
}

// Per-employee per-year overrides (carry-forward / manual adjustment). Used days are computed from approved requests.
model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  allowance   Decimal   @db.Decimal(5, 1)
  adjustment  Decimal   @default(0) @db.Decimal(5, 1)
  note        String?
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id            String      @id @default(uuid())
  employeeId    String
  employee      Employee    @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  halfDay       Boolean     @default(false)
  days          Decimal     @db.Decimal(5, 1)
  reason        String
  status        LeaveStatus @default(PENDING)
  approverId    String?
  approver      Employee?   @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decisionNote  String?
  decidedAt     DateTime?
  attachmentId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  region    String?
  createdAt DateTime @default(now())

  @@unique([date, name])
}

// ───────────────────────── Projects & Tasks ─────────────────────────

model Project {
  id              String          @id @default(uuid())
  name            String
  code            String?         @unique
  description     String?
  ownerId         String
  owner           Employee        @relation("ProjectOwner", fields: [ownerId], references: [id])
  status          ProjectStatus   @default(PLANNING)
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  manualProgress  Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  members         ProjectMember[]
  tasks           Task[]
  activities      ProjectActivity[]
  folders         Folder[]
}

model ProjectMember {
  projectId  String
  employeeId String
  role       String   @default("MEMBER") // OWNER, MANAGER, MEMBER, VIEWER
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@id([projectId, employeeId])
}

model ProjectActivity {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Task {
  id          String         @id @default(uuid())
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  assigneeId  String?
  assignee    Employee?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User           @relation("TaskCreator", fields: [createdById], references: [id])
  priority    TaskPriority   @default(MEDIUM)
  status      TaskStatus     @default(TODO)
  dueDate     DateTime?
  completedAt DateTime?
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    TaskComment[]
  subtasks    Subtask[]
  attachments TaskAttachment[]

  @@index([assigneeId])
  @@index([projectId])
  @@index([status])
}

model Subtask {
  id       String  @id @default(uuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title    String
  done     Boolean @default(false)
  position Int     @default(0)
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comment   String
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskAttachment {
  taskId String
  fileId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([taskId, fileId])
}

// ─────────────────────────── Chat ───────────────────────────

model Conversation {
  id          String               @id @default(uuid())
  type        ConversationType
  name        String?
  createdById String
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin        Boolean      @default(false)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  attachmentId   String?
  attachment     File?        @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  mentions       String[]     @default([])
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ─────────────────────────── Files ───────────────────────────

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope     String   @default("COMPANY") // COMPANY, PERSONAL, PROJECT, HR
  createdAt DateTime @default(now())
  files     File[]
  permissions FilePermission[]
}

model File {
  id            String   @id @default(uuid())
  name          String
  storageKey    String   @unique
  size          Int
  mimeType      String
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  folderId      String?
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  version       Int      @default(1)
  previousId    String?
  isSensitive   Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())

  permissions      FilePermission[]
  messages         Message[]
  taskAttachments  TaskAttachment[]
  employeeDocument EmployeeDocument?
  announcements    AnnouncementAttachment[]

  @@index([folderId])
}

model FilePermission {
  id          String      @id @default(uuid())
  fileId      String?
  file        File?       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  subjectType SubjectType
  subjectId   String
  accessLevel AccessLevel @default(VIEW)
  createdAt   DateTime    @default(now())
}

// ─────────────────────── Announcements & Notifications ───────────────────────

model Announcement {
  id                    String                   @id @default(uuid())
  title                 String
  body                  String
  audienceType          AudienceType             @default(ALL)
  audienceIds           String[]                 @default([])
  requiresAcknowledgement Boolean                @default(false)
  isPinned              Boolean                  @default(false)
  authorId              String
  author                User                     @relation(fields: [authorId], references: [id])
  publishedAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  acknowledgements      AnnouncementAck[]
  attachments           AnnouncementAttachment[]
}

model AnnouncementAck {
  announcementId String
  userId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())
  acknowledgedAt DateTime?

  @@id([announcementId, userId])
}

model AnnouncementAttachment {
  announcementId String
  fileId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  file           File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([announcementId, fileId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // TASK_ASSIGNED, TASK_DUE, LEAVE_SUBMITTED, LEAVE_DECIDED, ANNOUNCEMENT, CHAT_MESSAGE, ONBOARDING, ATTENDANCE_EXCEPTION, MENTION
  title     String
  body      String?
  link      String?
  entityType String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  userId  String
  type    String
  inApp   Boolean @default(true)
  email   Boolean @default(false)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

// ─────────────────────── Admin, Settings & Audit ───────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. employee.create, attendance.adjust, role.permissions.update
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ───────────────────────────── Payroll ─────────────────────────────
// Salary data is confidential: only payroll.* permission holders (and the employee, for their
// own published payslips) can read it. Audit entries record *that* a salary changed, not amounts.

/** A versioned salary package; the latest version effective on a date applies. */
model SalaryStructure {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  basicSalary   Decimal  @db.Decimal(12, 2)
  // [{ name, type: "EARNING" | "DEDUCTION", amount }] — recurring monthly allowances/deductions
  components    Json     @default("[]")
  taxMode       TaxMode  @default(NONE)
  taxValue      Decimal  @default(0) @db.Decimal(12, 2)
  bankName      String?
  bankAccount   String?
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveFrom])
}

model PayrollRun {
  id              String        @id @default(uuid())
  year            Int
  month           Int
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  workingDays     Int
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(14, 2)
  totalNet        Decimal       @default(0) @db.Decimal(14, 2)
  currency        String        @default("PKR")
  note            String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payslips        Payslip[]

  @@unique([year, month])
}

model Payslip {
  id               String     @id @default(uuid())
  runId            String
  run              PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary      Decimal    @db.Decimal(12, 2)
  earnings         Json       @default("[]") // [{ name, amount }] recurring allowances
  deductions       Json       @default("[]") // [{ name, amount }] recurring deductions
  adjustments      Json       @default("[]") // [{ name, type, amount }] one-off lines added during review
  workingDays      Int
  eligibleDays     Decimal    @db.Decimal(5, 1) // working days employed this period
  absentDays       Decimal    @db.Decimal(5, 1)
  unpaidLeaveDays  Decimal    @db.Decimal(5, 1)
  unpaidDaysOverride Decimal? @db.Decimal(5, 1) // set by payroll admin to override the calculation
  grossPay         Decimal    @db.Decimal(12, 2) // full-month earnings before unpaid days
  absenceDeduction Decimal    @db.Decimal(12, 2)
  taxAmount        Decimal    @db.Decimal(12, 2)
  totalDeductions  Decimal    @db.Decimal(12, 2)
  netPay           Decimal    @db.Decimal(12, 2)
  bankName         String?
  bankAccount      String?
  note             String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([runId, employeeId])
  @@index([employeeId])
}
